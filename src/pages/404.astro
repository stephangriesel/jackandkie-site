---
import Base from '../layouts/Base.astro';
import general from '../content/settings/site.json';
---
<Base title={`Page not found – ${general.title}`} description={general.description}>
  <main class="notfound">
    <a href="/"><img src={general.logo} alt={general.logo_alt} width="256" height="102" /></a>
    <h1>Page not found.</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <a class="cta-btn" href="/">Back to home</a>
  </main>
</Base>
