---
// Decap CMS entry point. Config is served from /admin/config.yml (public/admin/config.yml).
---
<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager</title>
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/decap-cms@3.17.3/dist/decap-cms.js"></script>
    <script is:inline>
      // Local editing only: Decap's local backend shows a one-click "Login" button. Click it automatically.
      if (['localhost', '127.0.0.1'].includes(location.hostname)) {
        const t = setInterval(() => {
          const b = [...document.querySelectorAll('button')].find((x) => /^\s*login\s*$/i.test(x.textContent));
          if (b) { clearInterval(t); b.click(); }
        }, 300);
        setTimeout(() => clearInterval(t), 15000);
      }
    </script>
  </body>
</html>
